---
import Layout from '../layouts/Layout.astro';
import { MyBooksGrid } from '../components/courses/MyBooksGrid';
---

<Layout title="Mis Libros | Élite Educativa">
  <main className="min-h-screen bg-slate-50 dark:bg-slate-900/50 pt-[100px] pb-16">
    <div class="max-w-[95%] mx-auto">
      <div className="mb-8">
        <h1 className="text-3xl sm:text-4xl font-display text-slate-900 dark:text-white mb-2">
          Mis Libros
        </h1>
        <p className="text-slate-500 dark:text-slate-400 text-sm sm:text-base max-w-2xl">
          Gestiona los libros y materiales que has compartido como profesor.
        </p>
      </div>
      
      <MyBooksGrid client:load />
    </div>
  </main>
</Layout>

<script>
  import { authService } from '../services/auth.service';
  const user = authService.getUser();
  if (!user || (user.role !== 'PROFESOR' && user.role !== 'ADMIN')) {
    window.location.href = '/acceso-denegado';
  }
</script>
