---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import booksData from '../../data/mock-books.json';

export function getStaticPaths() {
  return booksData.map((book) => ({
    params: { id: book.id },
    props: { book },
  }));
}

const { book } = Astro.props;
---

<Layout title={`${book.title} | Élite Educativa`}>
  <Navbar />
  
  <main class="pt-[72px] min-h-screen bg-[#F7F2E8]">
    <div class="container mx-auto px-6 py-12 md:py-24">
      <!-- Breadcrumbs -->
      <nav class="flex mb-12 text-[10px] uppercase tracking-[0.3em] text-primary/40 font-bold">
        <a href="/" class="hover:text-secondary transition-colors cursor-pointer">Inicio</a>
        <span class="mx-4">/</span>
        <a href="/libros" class="hover:text-secondary transition-colors cursor-pointer">Biblioteca</a>
        <span class="mx-4 text-secondary">/</span>
        <span class="text-primary/60">{book.title}</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24 items-start">
        
        <!-- Book Identity (Left) -->
        <div class="lg:col-span-5 space-y-12">
          <div class="aspect-[3/4] rounded-[20px] overflow-hidden shadow-[0_20px_50px_-15px_rgba(0,0,0,0.15)] border border-secondary/10 bg-white group relative">
            <img 
              src={book.image} 
              alt={book.title} 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-primary/20 to-transparent pointer-events-none"></div>
          </div>

          <div class="bg-white/40 backdrop-blur-md p-8 rounded-[16px] border border-white/60 shadow-sm space-y-6">
            <div class="flex justify-between items-start">
              <div>
                 <p class="text-[10px] uppercase tracking-[0.4em] text-secondary font-black mb-2">Precio de Colección</p>
                 <span class="text-5xl font-display font-bold text-primary">
                   {book.price}
                 </span>
              </div>
              <div class="bg-secondary/10 px-4 py-2 rounded-[8px] border border-secondary/20">
                <p class="text-[10px] uppercase tracking-widest text-secondary font-bold">Formato Digital</p>
                <p class="text-xs font-body font-bold text-primary">PDF Alta Resolución</p>
              </div>
            </div>

            <button class="w-full bg-primary text-white py-5 rounded-[12px] font-body font-bold tracking-[0.2em] uppercase hover:bg-secondary hover:text-primary transition-all duration-500 shadow-xl hover:shadow-secondary/20 group flex items-center justify-center gap-4 cursor-pointer">
              <span>Adquirir Ejemplar</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </button>
            
            <p class="text-[11px] text-center text-primary/40 font-body italic">
              * Acceso instantáneo tras la confirmación del pago.
            </p>
          </div>
        </div>

        <!-- Book Content & Viewer (Right) -->
        <div class="lg:col-span-7 space-y-12">
          <header class="space-y-6">
            <span class="inline-block bg-secondary text-primary px-4 py-1 rounded-full text-[10px] font-black uppercase tracking-[0.2em]">
              {book.category}
            </span>
            <h1 class="text-5xl md:text-6xl xl:text-7xl font-display text-primary font-bold leading-[1.1]">
              {book.title}
            </h1>
            <p class="text-primary/60 font-body text-xl font-light leading-relaxed max-w-2xl border-l-2 border-secondary/30 pl-8 py-2">
              {book.description}
            </p>
            <div class="flex gap-12 pt-4">
               <div>
                 <p class="text-[10px] uppercase tracking-widest text-primary/30 font-bold mb-1">Autoría</p>
                 <p class="font-display text-xl italic text-primary/80">{book.author}</p>
               </div>
               <div>
                 <p class="text-[10px] uppercase tracking-widest text-primary/30 font-bold mb-1">Extensión</p>
                 <p class="font-display text-xl italic text-primary/80">{book.pages} Páginas</p>
               </div>
            </div>
          </header>
          
          <!-- PDF Container -->
          <div class="space-y-8 pt-8">
            <div class="flex items-center justify-between border-b border-secondary/10 pb-4">
              <h2 class="text-2xl font-display text-primary italic font-medium">
                Exploración del Contenido <span class="text-secondary not-italic font-bold ml-2">(Muestra)</span>
              </h2>
              <div class="flex gap-4">
                <div class="w-3 h-3 rounded-full bg-secondary/40"></div>
                <div class="w-3 h-3 rounded-full bg-secondary/40"></div>
                <div class="w-3 h-3 rounded-full bg-secondary/40 animate-pulse"></div>
              </div>
            </div>
            
            <div class="relative group rounded-[20px] overflow-hidden border border-secondary/10 shadow-2xl bg-white">
              <!-- Visualizador PDF -->
              <div 
                id="pdf-viewer"
                class="w-full h-[700px] overflow-y-auto p-12 bg-gray-50/50 custom-scrollbar scroll-smooth"
              >
                <div class="max-w-2xl mx-auto space-y-16">
                  {[1, 2, 3, 4, 5].map((page) => (
                    <div class="pdf-page bg-white aspect-[1/1.41] w-full shadow-[0_5px_15px_rgba(0,0,0,0.05)] flex flex-col p-16 relative border border-gray-100">
                      <div class="absolute top-8 right-10 text-[9px] text-primary/20 font-black uppercase tracking-widest">Élite Educativa | Pág {page}</div>
                      
                      <div class="mt-8 space-y-4 opacity-10">
                        <div class="h-4 bg-primary w-full rounded-sm"></div>
                        <div class="h-4 bg-primary w-11/12 rounded-sm"></div>
                        <div class="h-4 bg-primary w-full rounded-sm"></div>
                        <div class="h-4 bg-primary w-10/12 rounded-sm"></div>
                      </div>
                      
                      <div class="flex-grow flex items-center justify-center">
                        <div class="text-center">
                           <p class="text-primary/10 font-display text-3xl italic select-none mb-4">
                             {book.title}
                           </p>
                           <div class="w-12 h-0.5 bg-secondary/10 mx-auto"></div>
                        </div>
                      </div>

                      <div class="space-y-4 opacity-10">
                        <div class="h-3 bg-primary w-full rounded-sm"></div>
                        <div class="h-3 bg-primary w-full rounded-sm"></div>
                        <div class="h-3 bg-primary w-2/3 rounded-sm"></div>
                      </div>
                    </div>
                  ))}
                  
                  <!-- Bloqueo de Contenido (Página 6 simulada) -->
                  <div id="locked-section" class="relative">
                    <div class="pdf-page bg-white aspect-[1/1.41] w-full shadow-lg flex flex-col p-16 blur-[8px] grayscale pointer-events-none opacity-40 border border-gray-100">
                       <div class="h-4 bg-primary w-full rounded-sm mb-4"></div>
                       <div class="h-4 bg-primary w-11/12 rounded-sm mb-4"></div>
                       <div class="h-4 bg-primary w-full rounded-sm mb-4"></div>
                    </div>
                    
                    <!-- Mensaje Dorado de Compra -->
                    <div class="absolute inset-0 flex items-center justify-center z-20 px-8">
                      <div class="bg-gradient-to-br from-[#C9A44A] via-[#E5C77E] to-[#B89336] text-primary p-10 rounded-[24px] shadow-[0_30px_60px_-15px_rgba(201,164,74,0.4)] text-center border-2 border-white/30 max-w-md transform transition-transform hover:scale-105 duration-500">
                        <div class="w-20 h-20 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-8">
                          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                        </div>
                        <h3 class="text-3xl font-display font-bold mb-4 uppercase tracking-wide">Contenido Exclusivo</h3>
                        <p class="font-body text-sm mb-8 leading-relaxed font-medium">
                          Has llegado al límite de la muestra gratuita. <br/> 
                          <span class="text-lg block mt-2">Adquiere la obra completa para desbloquear las <span class="font-black">{(book.pages || 100) - 5}</span> páginas restantes.</span>
                        </p>
                        <button class="bg-primary text-secondary w-full py-4 rounded-[12px] font-bold text-xs tracking-[0.2em] uppercase hover:bg-white hover:text-primary transition-all shadow-xl cursor-pointer">
                          Comprar Ahora
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              
              <!-- Controles del Visualizador -->
              <div class="absolute bottom-8 left-1/2 -translate-x-1/2 bg-primary/95 backdrop-blur-xl px-8 py-3 rounded-full border border-secondary/40 flex items-center gap-10 text-tertiary shadow-2xl z-30">
                 <button class="hover:text-secondary transition-colors cursor-pointer opacity-50" disabled>
                   <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                 </button>
                 <div class="flex flex-col items-center">
                   <span class="text-[9px] font-black tracking-[0.3em] text-secondary uppercase">Explorando</span>
                   <span class="text-xs font-bold font-body tracking-widest mt-0.5">PÁGINA 1 / {book.pages}</span>
                 </div>
                 <button id="next-btn" class="hover:text-secondary transition-colors cursor-pointer group">
                   <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform"><path d="m9 18 6-6-6-6"/></svg>
                 </button>
              </div>
            </div>
            
            <div class="flex items-center gap-4 justify-center py-4 bg-secondary/5 rounded-[12px] border border-secondary/10">
               <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C9A44A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/></svg>
               <p class="text-[10px] text-secondary font-bold uppercase tracking-widest">Visualización protegida por Élite Educativa DRM</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const viewer = document.getElementById('pdf-viewer');
  const nextBtn = document.getElementById('next-btn');
  const lockedSection = document.getElementById('locked-section');

  nextBtn?.addEventListener('click', () => {
    lockedSection?.scrollIntoView({ behavior: 'smooth' });
  });
</script>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #C9A44A;
    border-radius: 10px;
  }
  
  .pdf-page {
    box-shadow: 0 10px 30px rgba(0,0,0,0.03);
    transition: transform 0.3s ease;
  }
  
  .pdf-page:hover {
    transform: translateY(-5px);
  }

  h1, h2, h3, .font-display {
    font-family: 'Cormorant Garamond', serif;
  }
  
  .font-body {
    font-family: 'Raleway', sans-serif;
  }
</style>
