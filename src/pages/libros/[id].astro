---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { formatPrice } from '../../utils/format';

const { id } = Astro.params;
const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';

let book = null;

try {
  const response = await fetch(`${API_URL}/products/${id}`);
  
  if (!response.ok) {
    return Astro.redirect('/404');
  }

  const data = await response.json();
  
  // Mapping logic
  book = {
    ...data,
    image: data.coverUrl,
    author: data.bookMetadata?.author || 'Élite Educativa',
    pages: data.bookMetadata?.pages || 0,
    categoryName: data.category?.name || 'Sin Categoría',
  };

} catch (error) {
  console.error('[SSR Error] Failed to fetch book:', error);
  return Astro.redirect('/404');
}

if (!book) return Astro.redirect('/404');
---

<Layout title={`${book.title} | Élite Educativa`}>
  <Navbar />
  
  <main class="pt-[72px] min-h-screen bg-[#F7F2E8]">
    <div class="container mx-auto px-6 py-12 md:py-24">
      <!-- Breadcrumbs -->
      <nav class="flex mb-12 text-[10px] uppercase tracking-[0.3em] text-primary/40 font-bold">
        <a href="/" class="hover:text-secondary transition-colors cursor-pointer">Inicio</a>
        <span class="mx-4">/</span>
        <a href="/libros" class="hover:text-secondary transition-colors cursor-pointer">Biblioteca</a>
        <span class="mx-4 text-secondary">/</span>
        <span class="text-primary/60">{book.title}</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24 items-start">
        
        <!-- Book Cover (Left) -->
        <div class="lg:col-span-5">
          <div class="aspect-[3/4] rounded-[20px] overflow-hidden shadow-[0_20px_50px_-15px_rgba(0,0,0,0.15)] border border-secondary/10 bg-white group relative">
            <img 
              src={book.image} 
              alt={book.title} 
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-primary/20 to-transparent pointer-events-none"></div>
          </div>
        </div>

        <!-- Book Info & Action (Right) -->
        <div class="lg:col-span-7 space-y-10">
          <header class="space-y-6">
            <span class="inline-block bg-secondary text-primary px-4 py-1 rounded-full text-[10px] font-black uppercase tracking-[0.2em]">
              {book.categoryName}
            </span>
            <h1 class="text-5xl md:text-6xl xl:text-7xl font-display text-primary font-bold leading-[1.1]">
              {book.title}
            </h1>
            <p class="text-primary/60 font-body text-xl font-light leading-relaxed max-w-2xl border-l-2 border-secondary/30 pl-8 py-2">
              {book.description}
            </p>
          </header>

          <!-- Technical Details Grid -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-8 py-8 border-y border-secondary/10">
             <div>
               <p class="text-[10px] uppercase tracking-widest text-primary/30 font-bold mb-1">Autoría</p>
               <p class="font-display text-xl italic text-primary/80">{book.author}</p>
             </div>
             <div>
               <p class="text-[10px] uppercase tracking-widest text-primary/30 font-bold mb-1">Extensión</p>
               <p class="font-display text-xl italic text-primary/80">{book.pages || 0} Páginas</p>
             </div>
             <div>
               <p class="text-[10px] uppercase tracking-widest text-primary/30 font-bold mb-1">ISBN</p>
               <p class="font-display text-xl italic text-primary/80">{book.bookMetadata?.isbn || 'N/A'}</p>
             </div>
             <div>
               <p class="text-[10px] uppercase tracking-widest text-primary/30 font-bold mb-1">Formato</p>
               <p class="font-display text-xl italic text-primary/80">{book.bookMetadata?.format || 'Digital'}</p>
             </div>
             <div>
               <p class="text-[10px] uppercase tracking-widest text-primary/30 font-bold mb-1">Idioma</p>
               <p class="font-display text-xl italic text-primary/80">Español</p>
             </div>
          </div>

          <!-- Price & Action Section -->
          <div class="bg-white/40 backdrop-blur-md p-8 rounded-[16px] border border-white/60 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-8">
            <div>
               <p class="text-[10px] uppercase tracking-[0.4em] text-secondary font-black mb-2">Precio de Colección</p>
               <div class="flex items-baseline gap-4">
                 <span class="text-5xl font-display font-bold text-primary">
                   {formatPrice(book.price)}
                 </span>
                 <span class="text-xs text-primary/40 font-body">Format: PDF</span>
               </div>
            </div>

            <div class="w-full md:w-auto min-w-[240px]">
              <button 
                id="read-btn" 
                data-book-id={book.id} 
                data-api-url={API_URL}
                class="w-full bg-primary text-white py-5 px-8 rounded-[12px] font-body font-bold tracking-[0.2em] uppercase hover:bg-secondary hover:text-primary transition-all duration-500 shadow-xl hover:shadow-secondary/20 group flex items-center justify-center gap-4 cursor-pointer"
              >
                <span>Leer Obra</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-2">
                  <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
                  <circle cx="12" cy="12" r="3"/>
                </svg>
              </button>
            </div>
          </div>
        </div>

      </div>
    </div>
  </main>

  <!-- Modal de Compra Requerida / Acceso -->
  <div id="access-modal" class="fixed inset-0 z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
    <!-- Backdrop -->
    <div id="modal-backdrop" class="absolute inset-0 bg-primary/40 backdrop-blur-sm"></div>
    
    <!-- Content -->
    <div class="relative bg-[#F7F2E8] border border-secondary/30 rounded-[20px] p-8 md:p-10 max-w-md w-full mx-4 shadow-2xl transform scale-95 transition-transform duration-300 flex flex-col items-center text-center">
      <div class="w-16 h-16 rounded-full bg-secondary/10 flex items-center justify-center mb-6 border border-secondary/20">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#C9A44A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
      </div>
      
      <h3 class="font-display text-3xl font-bold text-primary mb-4 italic">Acceso Restringido</h3>
      
      <p id="modal-text" class="text-primary/70 font-body text-sm leading-relaxed mb-8">
        Este libro requiere una compra activa para ser leído.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 w-full">
        <button id="close-modal-btn" class="flex-1 px-6 py-3.5 border border-primary/20 rounded-[10px] text-xs font-bold font-body uppercase tracking-wider text-primary/60 hover:bg-primary/5 transition-all cursor-pointer">
          Cerrar
        </button>
        <a href="/libros" id="buy-book-btn" class="flex-1 px-6 py-3.5 bg-primary text-white rounded-[10px] text-xs font-bold font-body uppercase tracking-wider text-center hover:bg-secondary hover:text-primary transition-all cursor-pointer shadow-lg hover:shadow-secondary/20">
          Biblioteca
        </a>
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  const readBtn = document.getElementById('read-btn') as HTMLButtonElement | null;
  const accessModal = document.getElementById('access-modal');
  const closeModalBtn = document.getElementById('close-modal-btn');
  const modalBackdrop = document.getElementById('modal-backdrop');
  const modalText = document.getElementById('modal-text');
  const buyBookBtn = document.getElementById('buy-book-btn') as HTMLAnchorElement | null;

  function openModal(message: string, actionType: 'login' | 'library' = 'library') {
    if (accessModal && modalText) {
      modalText.textContent = message;
      
      if (buyBookBtn) {
        if (actionType === 'login') {
          buyBookBtn.href = '/login';
          buyBookBtn.textContent = 'Iniciar Sesión';
        } else {
          buyBookBtn.href = '/libros';
          buyBookBtn.textContent = 'Biblioteca';
        }
      }

      accessModal.classList.remove('hidden');
      // Force reflow
      accessModal.offsetHeight;
      accessModal.classList.remove('opacity-0');
      const inner = accessModal.querySelector('.relative');
      if (inner) {
        inner.classList.remove('scale-95');
        inner.classList.add('scale-100');
      }
    }
  }

  function closeModal() {
    if (accessModal) {
      accessModal.classList.add('opacity-0');
      const inner = accessModal.querySelector('.relative');
      if (inner) {
        inner.classList.remove('scale-100');
        inner.classList.add('scale-95');
      }
      setTimeout(() => {
        accessModal.classList.add('hidden');
      }, 300);
    }
  }

  closeModalBtn?.addEventListener('click', closeModal);
  modalBackdrop?.addEventListener('click', closeModal);

  readBtn?.addEventListener('click', async () => {
    const bookId = readBtn.getAttribute('data-book-id');
    const apiUrl = readBtn.getAttribute('data-api-url');
    const token = localStorage.getItem('accessToken');
    const sessionId = localStorage.getItem('activeSessionId');

    if (!token || token.trim() === '') {
      openModal("Debes iniciar sesión para leer este libro.", 'login');
      return;
    }

    try {
      readBtn.disabled = true;
      const originalText = readBtn.querySelector('span')?.textContent || '';
      const span = readBtn.querySelector('span');
      if (span) span.textContent = 'Cargando...';

      const response = await fetch(`${apiUrl}/products/${bookId}/read-url`, {
        headers: {
          'Authorization': `Bearer ${token}`,
          'x-session-id': sessionId || '',
          'Content-Type': 'application/json'
        }
      });

      if (response.status === 200 || response.status === 201) {
        const data = await response.json();
        if (data.url) {
          window.open(data.url, '_blank', 'noopener,noreferrer');
        } else {
          console.error('[ReadError] URL is empty in response:', data);
          openModal("Error al obtener la dirección del libro.");
        }
      } else if (response.status === 403) {
        openModal("Este libro requiere una compra activa para ser leído.", 'library');
      } else if (response.status === 401) {
        openModal("Tu sesión ha expirado. Por favor, inicia sesión nuevamente.", 'login');
      } else {
        // Observability rule: log detailed server error in console
        const errorText = await response.text();
        console.error(`[Access Error] Server returned code ${response.status}:`, errorText);
        openModal("Ocurrió un error en el servidor. Inténtalo de nuevo más tarde.");
      }

      if (span) span.textContent = originalText;
      readBtn.disabled = false;

    } catch (error) {
      // Observability rule: log network failure
      console.error('[Network Error] Failed to fetch read URL:', error);
      openModal("Error de conexión. Verifica tu conexión a internet.");
      
      const span = readBtn.querySelector('span');
      if (span) span.textContent = 'Leer Obra';
      readBtn.disabled = false;
    }
  });
</script>

<style>
  h1, h2, h3, .font-display {
    font-family: 'Cormorant Garamond', serif;
  }
  
  .font-body {
    font-family: 'Raleway', sans-serif;
  }
</style>
