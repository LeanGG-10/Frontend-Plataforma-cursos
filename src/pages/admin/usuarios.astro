---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/ui/Navbar.astro';
import { AdminUsersTable } from '../../components/admin/AdminUsersTable';

const year = new Date().getFullYear();
---

<Layout title="Gestión de Usuarios | Élite Educativa">
  <Navbar />

  <main class="min-h-screen bg-[#F7F2E8] pt-[100px] pb-16">
    <div class="max-w-[95%] mx-auto">

      <div class="mb-8">
        <h1 class="text-3xl sm:text-4xl font-display text-primary mb-2">
          Gestión de Usuarios
        </h1>
        <p class="text-primary/90 font-semibold text-sm sm:text-base max-w-2xl font-body">
          Administra los perfiles registrados en la plataforma, cambia sus roles y activa o desactiva sus cuentas.
        </p>
      </div>

      <div class="bg-white/80 rounded-lg shadow-sm border border-secondary/15 overflow-hidden">
        <AdminUsersTable client:load />
      </div>

    </div>
  </main>

  <div class="text-center text-sm text-secondary font-semibold py-8 border-t border-secondary/15 mt-12 bg-[#F7F2E8]">
    © {year} Élite Educativa · Panel de administración
  </div>
</Layout>

<script>
  // Fallback de seguridad del lado del cliente
  import { authService } from '../../services/auth.service';
  const user = authService.getUser();
  if (!user || user.role !== 'ADMIN') {
    window.location.href = '/acceso-denegado';
  }
</script>
