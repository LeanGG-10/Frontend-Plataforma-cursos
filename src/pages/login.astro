---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import logoLight from '../assets/logo-light-transparent.png';
import logoPrimary from '../assets/logo-primary.png';
import Button from '../components/ui/Button.astro';
---

<Layout title="Autenticación | Élite Educativa">
  <main class="min-h-screen w-full flex flex-col lg:flex-row overflow-y-auto bg-tertiary">
    <!-- Branding Panel (Izquierdo) -->
    <section class="hidden lg:flex w-1/2 min-h-screen bg-primary relative flex-col items-center justify-center p-12 overflow-hidden">
      <!-- Gradient Border -->
      <div class="absolute right-0 top-0 w-[1px] h-full bg-gradient-to-b from-transparent via-secondary/30 to-transparent"></div>
      
      <!-- Radial Glow & Grid -->
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(201,164,74,0.1),transparent_70%)] pointer-events-none"></div>
      <div class="absolute inset-0 dark-grid-pattern opacity-[0.045] pointer-events-none"></div>
      
      <div class="relative z-10 flex flex-col items-center text-center">
        <a href="/" class="mb-12 hover:opacity-80 transition-all duration-200 cursor-pointer">
          <Image src={logoLight} alt="Logo" width={200} class="h-auto" />
        </a>
        
        <h1 class="text-tertiary text-5xl xl:text-6xl font-light leading-tight">
          Tu puerta a la <br/>
          <span class="italic text-secondary">Excelencia</span> Académica
        </h1>
        
        <div class="mt-12 w-24 h-[1px] bg-secondary/30"></div>
        
        <p class="mt-8 text-tertiary/40 font-body text-sm tracking-widest uppercase font-medium">
          Formando para el Futuro
        </p>
      </div>

      <!-- Decorative Arch -->
      <div class="absolute -bottom-20 -left-20 w-80 h-80 border-[1px] border-secondary/10 rounded-full pointer-events-none"></div>
    </section>

    <!-- Form Panel (Derecho) -->
    <section class="w-full lg:w-1/2 min-h-screen flex flex-col items-center justify-center p-6 md:p-12 py-24 relative overflow-hidden">
      <!-- Decorative Arches -->
      <div class="absolute top-0 right-0 w-64 h-64 border-r border-t border-secondary/10 rounded-tr-[100px] pointer-events-none"></div>
      <div class="absolute bottom-0 left-0 w-64 h-64 border-l border-b border-secondary/10 rounded-bl-[100px] pointer-events-none"></div>

      <div class="w-full max-w-[400px] relative z-10">
        <!-- Logo for mobile -->
        <div class="lg:hidden flex justify-center mb-12">
          <Image src={logoPrimary} alt="Logo" width={180} />
        </div>

        <!-- Login View -->
        <div id="login-view" class="auth-view transition-opacity duration-300">
          <div id="login-banner" class="hidden mb-8 bg-secondary/10 border border-secondary/20 p-4 rounded-lg flex items-start gap-3 animate-fade-in">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C9A44A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 flex-shrink-0"><path d="M22 17a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9.5C2 7 4 5 6.5 5H18c2.2 0 4 1.8 4 4v8Z"/><path d="m22 10-8.53 4.42a2 2 0 0 1-1.94 0L3 10"/></svg>
            <p class="text-xs text-primary/70 leading-relaxed font-body">
              <span class="font-bold text-secondary">¿No recibiste el correo?</span><br/>
              Revisa tu bandeja de entrada o spam. Si persiste, intenta entrar para reenviarlo.
            </p>
          </div>

          <div id="password-updated-banner" class="hidden mb-8 bg-secondary/10 border border-secondary/20 p-4 rounded-lg flex items-start gap-3 animate-fade-in">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C9A44A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 flex-shrink-0"><path d="M22 17a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9.5C2 7 4 5 6.5 5H18c2.2 0 4 1.8 4 4v8Z"/><path d="m22 10-8.53 4.42a2 2 0 0 1-1.94 0L3 10"/></svg>
            <p class="text-xs text-primary/70 leading-relaxed font-body">
              <span class="font-bold text-secondary">Contraseña actualizada correctamente.</span><br/>
              Inicia sesión con tu nueva contraseña.
            </p>
          </div>

          <div class="mb-10">
            <h2 class="text-3xl font-display text-primary mb-2">Bienvenido de nuevo</h2>
            <p class="text-primary/50 text-sm font-body">Ingresa tus credenciales para acceder.</p>
          </div>

          <form id="login-form" class="space-y-8" novalidate>
            <div class="group relative">
              <label for="login-email" class="block text-[10px] font-bold uppercase tracking-widest text-primary/40 group-focus-within:text-secondary transition-colors">Correo Electrónico</label>
              <input 
                type="email" 
                id="login-email" 
                name="email"
                placeholder="ejemplo@elite.com"
                class="w-full bg-transparent border-b border-primary/10 py-3 outline-none focus:border-secondary transition-all font-body text-primary placeholder:text-primary/20"
              />
              <span class="error-msg text-[11px] text-red-500 mt-1 hidden">Correo electrónico no válido</span>
            </div>

            <div class="group relative">
              <label for="login-password" class="block text-[10px] font-bold uppercase tracking-widest text-primary/40 group-focus-within:text-secondary transition-colors">Contraseña</label>
              <div class="relative">
                <input 
                  type="password" 
                  id="login-password" 
                  name="password"
                  placeholder="••••••••"
                  maxlength="12"
                  class="w-full bg-transparent border-b border-primary/10 py-3 outline-none focus:border-secondary transition-all font-body text-primary placeholder:text-primary/20"
                />
                <button type="button" class="toggle-password absolute right-0 top-1/2 -translate-y-1/2 text-primary/30 hover:text-secondary transition-all duration-200 p-2 cursor-pointer hover:-translate-y-[calc(50%+1px)]">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
              </div>
              <span class="pass-limit-msg text-[10px] text-secondary mt-1 hidden italic animate-pulse">Límite de 12 caracteres alcanzado</span>
              <span class="error-msg text-[11px] text-red-500 mt-1 hidden">La contraseña es obligatoria (máx 12 caracteres)</span>
            </div>

            <div class="flex items-center justify-between pt-2">
              <label class="flex items-center gap-2 cursor-pointer group">
                <input type="checkbox" class="accent-secondary h-4 w-4" />
                <span class="text-xs text-primary/50 group-hover:text-primary transition-colors">Recordarme</span>
              </label>
              <a href="/forgot-password" class="text-xs text-secondary font-bold hover:text-secondary/80 transition-all duration-200 cursor-pointer">¿Olvidaste tu contraseña?</a>
            </div>

            <Button type="submit" class="w-full py-4 mt-4">
              Iniciar Sesión
            </Button>
          </form>

          <p class="mt-8 text-center text-sm text-primary/40 font-body">
            ¿No tienes una cuenta? 
            <button id="show-register" class="text-secondary font-bold hover:text-secondary/80 transition-all duration-200 cursor-pointer ml-1">Regístrate</button>
          </p>
        </div>

        <!-- Register View -->
        <div id="register-view" class="auth-view hidden opacity-0 transition-opacity duration-300">
          <div class="mb-10">
            <h2 class="text-3xl font-display text-primary mb-2">Crear Cuenta</h2>
            <p class="text-primary/50 text-sm font-body">Únete a la élite educativa hoy mismo.</p>
          </div>

          <form id="register-form" class="space-y-6" novalidate>
            <div class="group relative">
              <label for="reg-name" class="block text-[10px] font-bold uppercase tracking-widest text-primary/40 group-focus-within:text-secondary transition-colors">Nombre Completo</label>
              <input 
                type="text" 
                id="reg-name" 
                name="name"
                placeholder="Juan Pérez"
                class="w-full bg-transparent border-b border-primary/10 py-3 outline-none focus:border-secondary transition-all font-body text-primary placeholder:text-primary/20"
              />
              <span class="error-msg text-[11px] text-red-500 mt-1 hidden">El nombre es obligatorio</span>
            </div>

            <div class="group relative">
              <label for="reg-email" class="block text-[10px] font-bold uppercase tracking-widest text-primary/40 group-focus-within:text-secondary transition-colors">Correo Electrónico</label>
              <input 
                type="email" 
                id="reg-email" 
                name="email"
                placeholder="ejemplo@elite.com"
                class="w-full bg-transparent border-b border-primary/10 py-3 outline-none focus:border-secondary transition-all font-body text-primary placeholder:text-primary/20"
              />
              <span class="error-msg text-[11px] text-red-500 mt-1 hidden">Correo electrónico no válido</span>
            </div>

            <div class="group relative">
              <label for="reg-password" class="block text-[10px] font-bold uppercase tracking-widest text-primary/40 group-focus-within:text-secondary transition-colors">Contraseña</label>
              <div class="relative">
                <input 
                  type="password" 
                  id="reg-password" 
                  name="password"
                  placeholder="Min. 6 caracteres, máx. 12"
                  maxlength="12"
                  class="w-full bg-transparent border-b border-primary/10 py-3 outline-none focus:border-secondary transition-all font-body text-primary placeholder:text-primary/20"
                />
                <button type="button" class="toggle-password absolute right-0 top-1/2 -translate-y-1/2 text-primary/30 hover:text-secondary transition-all duration-200 p-2 cursor-pointer hover:-translate-y-[calc(50%+1px)]">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
              </div>
              <span class="pass-limit-msg text-[10px] text-secondary mt-1 hidden italic animate-pulse">Límite de 12 caracteres alcanzado</span>
              <span class="error-msg text-[11px] text-red-500 mt-1 hidden">La contraseña debe tener entre 6 y 12 caracteres</span>
            </div>

            <div class="group relative">
              <label for="reg-confirm" class="block text-[10px] font-bold uppercase tracking-widest text-primary/40 group-focus-within:text-secondary transition-colors">Confirmar Contraseña</label>
              <input 
                type="password" 
                id="reg-confirm" 
                placeholder="Repite tu contraseña"
                maxlength="12"
                class="w-full bg-transparent border-b border-primary/10 py-3 outline-none focus:border-secondary transition-all font-body text-primary placeholder:text-primary/20"
              />
              <span class="error-msg text-[11px] text-red-500 mt-1 hidden">Las contraseñas no coinciden</span>
            </div>

            <Button type="submit" class="w-full py-4 mt-4">
              Crear Cuenta
            </Button>
          </form>

          <p class="mt-8 text-center text-sm text-primary/40 font-body">
            ¿Ya tienes una cuenta? 
            <button id="show-login" class="text-secondary font-bold hover:text-secondary/80 transition-all duration-200 cursor-pointer ml-1">Inicia Sesión</button>
          </p>
        </div>

        <!-- Success/Confirmation View -->
        <div id="success-view" class="auth-view hidden opacity-0 transition-opacity duration-500 text-center py-8">
          <div class="w-24 h-24 bg-secondary/10 rounded-full flex items-center justify-center mx-auto mb-10 border border-secondary/20 scale-110 animate-bounce-subtle">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#C9A44A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 17a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9.5C2 7 4 5 6.5 5H18c2.2 0 4 1.8 4 4v8Z"/><path d="m22 10-8.53 4.42a2 2 0 0 1-1.94 0L3 10"/></svg>
          </div>
          
          <h2 class="text-3xl font-display text-primary mb-4 italic">¡Casi listo! Solo un paso más.</h2>
          <p class="text-primary/60 text-base font-body mb-10 leading-relaxed max-w-sm mx-auto">
            Hemos enviado un enlace de confirmación a tu correo. Por favor, revísalo (incluso en spam) para activar tu cuenta y acceder a la biblioteca.
          </p>
          
          <Button id="success-understood" class="w-full py-4 shadow-secondary/10">
            Entendido
          </Button>
        </div>
      </div>
      </div>

      <!-- Bottom link back to home -->
      <div class="mt-16 lg:mt-24 text-center">
        <a href="/" class="text-[10px] uppercase tracking-[0.3em] font-bold text-primary/30 hover:text-secondary transition-all duration-200 cursor-pointer">
          Volver al Inicio
        </a>
      </div>
    </section>

    <!-- Global Toast Container -->
    <div id="toast-container" class="fixed top-8 right-8 z-[100] flex flex-col gap-4 pointer-events-none"></div>
  </main>
</Layout>

<script>
  import { authService } from '../services/auth.service';

  // DOM Elements
  const loginView = document.getElementById('login-view') as HTMLElement;
  const registerView = document.getElementById('register-view') as HTMLElement;
  const successView = document.getElementById('success-view') as HTMLElement;
  const loginBanner = document.getElementById('login-banner') as HTMLElement;
  const pwdUpdatedBanner = document.getElementById('password-updated-banner') as HTMLElement;
  const toastContainer = document.getElementById('toast-container') as HTMLElement;
  
  const showRegisterBtn = document.getElementById('show-register') as HTMLElement;
  const showLoginBtn = document.getElementById('show-login') as HTMLElement;
  const successUnderstoodBtn = document.getElementById('success-understood') as HTMLElement;
  const togglePassBtns = document.querySelectorAll('.toggle-password');
  
  const loginForm = document.getElementById('login-form') as HTMLFormElement;
  const registerForm = document.getElementById('register-form') as HTMLFormElement;

  // Toast Function
  function showToast(message: string, type: 'success' | 'error' | 'info' = 'info') {
    const toast = document.createElement('div');
    const bgColor = type === 'success' ? 'bg-secondary' : type === 'error' ? 'bg-red-500' : 'bg-primary';
    const textColor = type === 'success' ? 'text-primary' : 'text-white';
    
    toast.className = `${bgColor} ${textColor} px-6 py-4 rounded-xl shadow-2xl flex items-center gap-3 pointer-events-auto animate-slide-in`;
    toast.innerHTML = `
      <span class="text-xs font-bold uppercase tracking-widest">${message}</span>
      <button class="ml-2 hover:opacity-50 transition-opacity">✕</button>
    `;
    
    toast.querySelector('button')?.addEventListener('click', () => {
      toast.classList.add('opacity-0', 'translate-x-full');
      setTimeout(() => toast.remove(), 300);
    });
    
    toastContainer.appendChild(toast);
    setTimeout(() => {
      if (toast.parentElement) {
        toast.classList.add('opacity-0', 'translate-x-full');
        setTimeout(() => toast.remove(), 300);
      }
    }, 5000);
  }

  // View Switching Logic
  function hideAllViews() {
    [loginView, registerView, successView].forEach(view => {
      view.classList.add('hidden', 'opacity-0');
    });
  }

  function showView(view: HTMLElement) {
    hideAllViews();
    view.classList.remove('hidden');
    setTimeout(() => view.classList.remove('opacity-0'), 50);
  }

  function switchToLogin(withBanner = false) {
    if (withBanner) loginBanner.classList.remove('hidden');
    showView(loginView);
    window.location.hash = '';
  }

  function switchToRegister() {
    showView(registerView);
    window.location.hash = 'register';
  }

  function switchToSuccess() {
    showView(successView);
  }

  // Toggle Password Visibility
  togglePassBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const input = btn.previousElementSibling as HTMLInputElement;
      const type = input.getAttribute('type') === 'password' ? 'text' : 'password';
      input.setAttribute('type', type);
      
      btn.innerHTML = type === 'text' 
        ? '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88 12 12l2.12 2.12M15.12 15.12 17 17M2 12l2-2m6-2 2-2 3 3M19 12l3 3M3 3l18 18"/></svg>'
        : '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>';
    });
  });

  // Validation UI helpers
  function validateEmail(email: string) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  function showError(input: HTMLInputElement, show: boolean, customMsg?: string) {
    const group = input.closest('.group');
    if (!group) return;
    const errorMsg = group.querySelector('.error-msg') as HTMLElement;
    if (show) {
      if (customMsg) errorMsg.innerHTML = customMsg;
      errorMsg.classList.remove('hidden');
      input.classList.add('border-red-500');
    } else {
      errorMsg.classList.add('hidden');
      input.classList.remove('border-red-500');
    }
  }

  function setSubmitting(form: HTMLFormElement, isSubmitting: boolean) {
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalText = btn.getAttribute('data-original-text') || btn.textContent;
    
    if (isSubmitting) {
      btn.setAttribute('data-original-text', originalText || '');
      btn.disabled = true;
      btn.innerHTML = `
        <span class="flex items-center justify-center gap-2">
          <svg class="animate-spin h-4 w-4" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
          Procesando...
        </span>
      `;
      btn.classList.add('opacity-70', 'cursor-not-allowed');
    } else {
      btn.disabled = false;
      btn.textContent = originalText;
      btn.classList.remove('opacity-70', 'cursor-not-allowed');
    }
  }

  // Event Listeners
  showRegisterBtn.addEventListener('click', switchToRegister);
  showLoginBtn.addEventListener('click', () => switchToLogin());
  successUnderstoodBtn.addEventListener('click', () => switchToLogin(true));

  // Handle Hash on Load
  if (window.location.hash === '#register') {
    switchToRegister();
  }

  // Handle Search Params
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('message') === 'password_updated') {
    pwdUpdatedBanner?.classList.remove('hidden');
    window.history.replaceState({}, document.title, window.location.pathname);
  }

  // Hide banner on input interaction
  loginForm.addEventListener('input', () => {
    pwdUpdatedBanner?.classList.add('hidden');
  });

  // Login Submission
  loginForm.addEventListener('submit', async (e: SubmitEvent) => {
    e.preventDefault();
    const emailInput = document.getElementById('login-email') as HTMLInputElement;
    const passInput = document.getElementById('login-password') as HTMLInputElement;
    
    let isValid = true;
    if (!validateEmail(emailInput.value)) { showError(emailInput, true); isValid = false; } else { showError(emailInput, false); }
    if (passInput.value.length === 0) { showError(passInput, true); isValid = false; } else { showError(passInput, false); }

    if (!isValid) return;

    setSubmitting(loginForm, true);
    showToast('Validando credenciales...', 'info');

    try {
      await authService.login(emailInput.value, passInput.value);
      showToast('¡Bienvenido de nuevo!', 'success');
      setTimeout(() => window.location.href = '/libros', 1000);
    } catch (err: any) {
      console.error('[LoginError]', err);
      const msg = Array.isArray(err.message) ? err.message[0] : err.message;
      
      // Smart 401 handling
      if (err.statusCode === 401) {
        const smartMsg = `
          Credenciales inválidas. Si acabas de registrarte, asegúrate de haber confirmado tu correo.
          <button id="resend-btn" class="block mt-2 text-secondary font-bold underline cursor-pointer">Reenviar correo de confirmación</button>
        `;
        showError(passInput, true, smartMsg);
        
        // Add listener to the dynamic button
        setTimeout(() => {
          const resendBtn = document.getElementById('resend-btn');
          resendBtn?.addEventListener('click', async () => {
            resendBtn.textContent = 'Enviando...';
            try {
              await authService.resendConfirmation(emailInput.value);
              showToast('Correo reenviado con éxito', 'success');
              resendBtn.textContent = '¡Enviado!';
              resendBtn.classList.add('text-green-500');
            } catch (resendErr) {
              showToast('Error al reenviar. Intenta más tarde.', 'error');
              resendBtn.textContent = 'Reenviar de nuevo';
            }
          });
        }, 10);
      } else {
        showError(passInput, true, msg);
      }
    } finally {
      setSubmitting(loginForm, false);
    }
  });

  // Register Submission
  registerForm.addEventListener('submit', async (e: SubmitEvent) => {
    e.preventDefault();
    const nameInput = document.getElementById('reg-name') as HTMLInputElement;
    const emailInput = document.getElementById('reg-email') as HTMLInputElement;
    const passInput = document.getElementById('reg-password') as HTMLInputElement;
    const confirmInput = document.getElementById('reg-confirm') as HTMLInputElement;

    let isValid = true;
    if (nameInput.value.trim().length < 3) { showError(nameInput, true); isValid = false; } else { showError(nameInput, false); }
    if (!validateEmail(emailInput.value)) { showError(emailInput, true); isValid = false; } else { showError(emailInput, false); }
    if (passInput.value.length < 6) { showError(passInput, true); isValid = false; } else { showError(passInput, false); }
    if (passInput.value !== confirmInput.value) { showError(confirmInput, true); isValid = false; } else { showError(confirmInput, false); }

    if (!isValid) return;

    setSubmitting(registerForm, true);
    showToast('Creando tu perfil élite...', 'info');

    try {
      await authService.register(nameInput.value, emailInput.value, passInput.value);
      showToast('Cuenta creada con éxito', 'success');
      setTimeout(() => switchToSuccess(), 300);
    } catch (err: any) {
      console.error('[RegisterError]', err);
      const msg = Array.isArray(err.message) ? err.message[0] : err.message;
      showError(emailInput, true, msg);
      showToast('Error al registrar', 'error');
    } finally {
      setSubmitting(registerForm, false);
    }
  });
</script>

<style>
  .auth-view {
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  @keyframes slideIn {
    from { opacity: 0; transform: translateX(100%) scale(0.9); }
    to { opacity: 1; transform: translateX(0) scale(1); }
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes bounceSubtle {
    0%, 100% { transform: translateY(0) scale(1.1); }
    50% { transform: translateY(-10px) scale(1.15); }
  }

  .animate-slide-in {
    animation: slideIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  .animate-fade-in {
    animation: fadeIn 0.6s ease-out forwards;
  }

  .animate-bounce-subtle {
    animation: bounceSubtle 3s ease-in-out infinite;
  }
</style>
