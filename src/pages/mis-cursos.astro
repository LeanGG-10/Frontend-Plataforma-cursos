---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/ui/Navbar.astro';
import { MyCoursesGrid } from '../components/courses/MyCoursesGrid';
---

<Layout title="Mis Cursos | Élite Educativa">
  <Navbar />
  <main class="min-h-screen bg-[#F7F2E8] pt-[100px] pb-16">
    <div class="max-w-[95%] mx-auto">
      <div class="mb-8">
        <h1 class="text-3xl sm:text-4xl font-display text-primary mb-2">
          Mis Cursos
        </h1>
        <p class="text-primary/90 font-semibold text-sm sm:text-base max-w-2xl font-body">
          Gestiona los cursos que has creado como profesor.
        </p>
      </div>
      
      <MyCoursesGrid client:load />
    </div>
  </main>
</Layout>

<script>
  import { authService } from '../services/auth.service';
  const user = authService.getUser();
  if (!user || (user.role !== 'PROFESOR' && user.role !== 'ADMIN')) {
    window.location.href = '/acceso-denegado';
  }
</script>
