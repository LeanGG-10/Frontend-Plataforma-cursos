---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Acceso Denegado | Élite Educativa">
  <main class="min-h-screen bg-slate-50 dark:bg-slate-900/50 flex flex-col items-center justify-center px-4">
    <div class="text-center max-w-md">
      <h1 class="text-4xl sm:text-5xl font-display text-slate-900 dark:text-white mb-4">
        Acceso Denegado
      </h1>
      <p class="text-slate-600 dark:text-slate-400 mb-8">
        No tienes permisos para ver esta página. Si crees que esto es un error, por favor contacta al administrador.
      </p>
      <a href="/" class="inline-flex justify-center rounded-md border border-transparent bg-indigo-600 py-2 px-4 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900 transition-colors">
        Volver al Inicio
      </a>
    </div>
  </main>
</Layout>
