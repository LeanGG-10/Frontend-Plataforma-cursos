---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/ui/Navbar.astro';
import Footer from '../components/Footer.astro';
import { CourseGrid } from '../components/courses/CourseGrid';
import AdminToggle from '../components/admin/AdminToggle';
---

<Layout title="Cursos | Élite Educativa">
  <Navbar />
  
  <main class="pt-[72px] min-h-screen bg-[#F7F2E8]">
    <!-- Hero Section for Courses -->
    <section class="bg-primary text-secondary py-20 px-6 text-center border-b border-secondary/20">
      <div class="container mx-auto max-w-4xl">
        <h1 class="text-5xl md:text-6xl font-display font-bold mb-6 italic">Catálogo de Cursos</h1>
        <p class="text-lg md:text-xl font-body text-secondary/80 max-w-2xl mx-auto">
          Explora nuestra selección de cursos diseñados para impulsar tu desarrollo profesional y personal con los mejores instructores.
        </p>
      </div>
    </section>

    <!-- Dashboard Section -->
    <section class="py-16 bg-white/30 backdrop-blur-sm border-t border-secondary/10">
      <div class="max-w-[95%] mx-auto">
        <!-- Toolbar Minimalista -->
        <div class="flex flex-col md:flex-row justify-between items-center mb-12 gap-8 bg-white/50 p-6 rounded-[16px] border border-secondary/5 shadow-sm">
          <div class="w-full md:w-auto flex flex-col md:flex-row items-center gap-6">
            <div class="relative w-full md:w-64 group">
              <label for="category-filter" class="block text-[10px] uppercase tracking-[0.2em] text-primary/90 font-bold mb-2 ml-1">
                Filtrar por Especialidad
              </label>
              <div class="relative">
                <select 
                  id="category-filter"
                  class="w-full bg-white border border-secondary/10 rounded-[10px] px-5 py-3.5 text-primary font-body text-sm appearance-none cursor-pointer focus:outline-none focus:ring-2 focus:ring-secondary/20 transition-all hover:border-secondary/30"
                >
                  <option value="Todas">Todas</option>
                </select>
                <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none text-secondary transition-transform duration-300 group-hover:translate-y-[-40%]">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                </div>
              </div>
            </div>
            
            <div class="h-10 w-[1px] bg-secondary/10 hidden md:block"></div>
            
            <div id="category-pills" class="flex gap-2">
            </div>
          </div>
          
          <div class="flex flex-col items-end gap-4">
            <div class="flex flex-col items-end">
              <p class="text-primary/30 font-body text-[11px] uppercase tracking-widest mb-1">Inventario de Cursos</p>
              <p class="text-primary/80 font-display text-xl italic">
                <span id="count" class="text-secondary font-bold not-italic">0</span> Cursos disponibles
              </p>
            </div>
            
            <AdminToggle client:only="react" label="Cursos" />
          </div>
        </div>

        <!-- Grid de Cursos Interactiva -->
        <CourseGrid client:load />
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  select {
    background-image: none;
  }
</style>
