---
// src/components/PayPalPaymentButton.astro

interface Props {
  bookId: string;
  bookPrice: string | number;
  apiUrl: string;
}

const { bookId, bookPrice, apiUrl } = Astro.props;
const paypalClientId = import.meta.env.PUBLIC_PAYPAL_CLIENT_ID;
---

<div 
  class="w-full flex flex-col gap-4 elite-paypal-wrapper" 
  data-book-id={bookId} 
  data-book-price={bookPrice} 
  data-api-url={apiUrl}
  data-paypal-client-id={paypalClientId}
>
  <!-- Loader Spinner (Initial verification state) -->
  <div id="paypal-loading" class="w-full py-5 flex items-center justify-center gap-3 text-primary/90 font-semibold font-body text-sm font-semibold">
    <svg class="animate-spin h-5 w-5 text-secondary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
    <span>Verificando acceso...</span>
  </div>

  <!-- Login Prompt Button (Shown if not logged in) -->
  <div id="paypal-login-prompt" class="hidden w-full text-center p-6 border border-secondary/20 rounded-[16px] bg-white/20 backdrop-blur-sm shadow-sm">
    <p class="text-sm font-body text-primary/90 font-semibold mb-6 font-semibold leading-relaxed">Debes iniciar sesión para adquirir este libro.</p>
    <a 
      href="/login" 
      class="flex items-center justify-center w-full bg-primary text-white py-4 px-6 rounded-full font-body font-bold text-xs tracking-wider uppercase hover:bg-secondary hover:text-primary transition-all duration-300 shadow-lg hover:shadow-secondary/20 hover:-translate-y-0.5 active:translate-y-0"
    >
      Iniciar Sesión
    </a>
  </div>

  <!-- Read Book Button (Shown if purchased or admin) -->
  <button 
    id="paypal-read-btn" 
    class="hidden w-full bg-primary text-white py-5 px-8 rounded-[12px] font-body font-bold tracking-[0.2em] uppercase hover:bg-secondary hover:text-primary transition-all duration-500 shadow-xl hover:shadow-secondary/20 flex items-center justify-center gap-4 cursor-pointer"
  >
    <span>Leer Obra</span>
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-2">
      <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
      <circle cx="12" cy="12" r="3"/>
    </svg>
  </button>

  <!-- PayPal Buttons Container (Shown if not purchased) -->
  <div id="paypal-buttons-container" class="hidden w-full flex flex-col gap-2">
    <div id="paypal-button-mount" class="w-full min-h-[50px]"></div>
  </div>

  <!-- Dynamic Feedback Banner (Success / Info messages) -->
  <div id="paypal-feedback-banner" class="hidden p-4 rounded-[12px] bg-green-50 border border-green-200 text-green-800 text-xs font-body items-start gap-3 shadow-sm transition-all duration-300">
    <svg class="w-5 h-5 shrink-0 text-green-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <div class="flex-grow">
      <p class="font-bold mb-0.5">¡Compra Exitosa!</p>
      <p id="paypal-feedback-message">El pago se ha procesado con éxito. Ya puedes leer la obra.</p>
    </div>
  </div>

  <!-- Premium Error Alert Banner -->
  <div id="paypal-error-banner" class="hidden p-4 rounded-[12px] bg-red-50 border border-red-200 text-red-800 text-xs font-body items-start gap-3 shadow-sm transition-all duration-300 relative">
    <svg class="w-5 h-5 shrink-0 text-red-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
    </svg>
    <div class="flex-grow pr-6">
      <p class="font-bold mb-0.5" id="paypal-error-title">No se pudo procesar la solicitud</p>
      <p id="paypal-error-message"></p>
    </div>
    <button id="paypal-error-close" class="absolute top-3 right-3 text-red-400 hover:text-red-700 font-bold text-base cursor-pointer focus:outline-none" aria-label="Cerrar">&times;</button>
  </div>
</div>

<script>
  import './paypal-button.ts';
</script>

<style>
  .font-body {
    font-family: 'Raleway', sans-serif;
  }
</style>
