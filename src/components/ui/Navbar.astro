---
import { Image } from 'astro:assets';
// Ajuste de rutas relativas considerando que ahora está en /ui
import logoLight from '../../assets/logo-light-transparent.png';
import { MobileMenu } from './MobileMenu';
import { UserMenu } from './UserMenu';

const navLinks = [
  { name: 'Inicio', href: '/' },
  { name: 'Libros', href: '/libros' },
  { name: 'Cursos', href: '/cursos' },
  { name: 'Sobre Nosotros', href: '#nosotros' },
];
---

<nav class="fixed top-0 left-0 w-full h-[72px] bg-primary border-b border-secondary/25 z-50 flex items-center px-4 md:px-8 lg:px-12 justify-between">
  <!-- Logo (Mantiene z-index superior para verse sobre el menú desplegado) -->
  <div class="flex items-center">
    <a href="/" class="flex items-center cursor-pointer transition-opacity duration-200 hover:opacity-80 relative z-[60]">
      <Image src={logoLight} alt="Élite Educativa Logo" height={40} class="h-10 w-auto" />
    </a>
  </div>

  <!-- Enlaces de Escritorio (Ocultos en Mobile y Tablets) -->
  <div class="hidden lg:flex items-center space-x-6 xl:space-x-8">
    {navLinks.map(link => (
      <a 
        href={link.href} 
        class="text-tertiary/80 hover:text-secondary transition-colors duration-200 font-body text-sm tracking-widest uppercase font-medium cursor-pointer"
      >
        {link.name}
      </a>
    ))}
  </div>

  <!-- Controles a la Derecha -->
  <div class="flex items-center space-x-3 md:space-x-4">
    <!-- Componente React UserMenu interactivo -->
    <UserMenu client:load />
    
    <!-- React Island: Menú Hamburguesa Interactivo -->
    <MobileMenu links={navLinks} client:load />
  </div>
</nav>
