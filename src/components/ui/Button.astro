---
interface Props {
  variant?: 'primary' | 'outline' | 'ghost';
  href?: string;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  id?: string;
}

const { 
  variant = 'primary', 
  href, 
  class: className = '', 
  type = 'button',
  id
} = Astro.props;

const baseStyles = "inline-block px-8 py-3 text-sm tracking-[0.2em] uppercase font-bold transition-all duration-500 rounded-md text-center";

const variants = {
  primary: "bg-secondary text-primary hover:bg-tertiary shadow-xl",
  outline: "border border-secondary text-secondary hover:bg-secondary/10",
  ghost: "text-tertiary hover:text-secondary",
};

const Tag = href ? 'a' : 'button';
---

<Tag 
  href={href} 
  type={!href ? type : undefined}
  id={id}
  class:list={[baseStyles, variants[variant], className]}
>
  <slot />
</Tag>
