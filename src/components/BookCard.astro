---
interface Props {
  id: string;
  title: string;
  author: string;
  price: string;
  category: string;
  image: string;
  variant?: 'light' | 'dark';
}

import { formatPrice } from '../utils/format';
const { id, title, author, price, category, image, variant = 'light' } = Astro.props;

const formattedPrice = formatPrice(price);

// Use Bone White (#F7F2E8) which is 'tertiary' in tailwind.config.mjs
const bgClass = variant === 'light' ? 'bg-tertiary' : 'bg-primary';
const textClass = variant === 'light' ? 'text-primary' : 'text-tertiary';
// Soft shadow as requested
const shadowClass = 'shadow-[0_4px_20px_-5px_rgba(0,0,0,0.05)] hover:shadow-[0_10px_40px_-10px_rgba(0,0,0,0.1)]';
---

<div class={`group cursor-pointer p-6 rounded-[12px] transition-all duration-500 border border-secondary/5 ${bgClass} ${shadowClass} hover:scale-105 flex flex-col h-full relative overflow-hidden`}>
  <div class="aspect-[3/4] mb-6 overflow-hidden relative rounded-[8px] bg-white/10">
    <img 
      src={image} 
      alt={title} 
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
    />
    
    <!-- Action Button - Fades in on hover -->
    <div class="absolute inset-0 bg-primary/40 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center backdrop-blur-[2px]">
      <a 
        href={`/libros/${id}`}
        class="bg-secondary text-primary px-6 py-2.5 rounded-[8px] font-body text-[11px] font-bold tracking-widest uppercase transform translate-y-4 group-hover:translate-y-0 transition-all duration-500 hover:bg-white hover:scale-105"
      >
        Ver detalles
      </a>
    </div>
    
    <span class="absolute top-4 left-4 bg-secondary/90 backdrop-blur-sm text-primary px-3 py-1 rounded-[6px] text-[10px] font-black uppercase tracking-wider shadow-sm">
      {typeof category === 'object' && category !== null ? (category as any).name : category}
    </span>
  </div>
  
  <div class="space-y-2 flex-grow">
    <h3 class={`text-xl font-display font-semibold transition-colors duration-300 group-hover:text-secondary ${textClass}`}>
      {title}
    </h3>
    <p class={`text-sm font-body italic opacity-60 ${textClass}`}>
      {author}
    </p>
  </div>
  
  <div class="pt-6 flex justify-between items-center border-t border-secondary/10 mt-4">
    <span class={`text-lg font-display font-bold ${textClass}`}>
      {formattedPrice}
    </span>
    <div class="text-secondary opacity-40 group-hover:opacity-100 transition-opacity duration-300">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
    </div>
  </div>
</div>

<style>
  div {
    cursor: pointer;
  }
</style>
