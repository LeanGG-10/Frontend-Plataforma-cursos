---
const features = [
  {
    title: 'Calidad Premium',
    desc: 'Contenidos desarrollados por expertos de la industria con un enfoque en la aplicabilidad práctica.',
    icon: 'star'
  },
  {
    title: 'Acceso Instantáneo',
    desc: 'Descarga tus libros inmediatamente después de la compra y accede desde cualquier dispositivo.',
    icon: 'zap'
  },
  {
    title: 'Diseño Editorial',
    desc: 'Cada libro es una pieza de diseño, optimizada para una lectura cómoda y estéticamente placentera.',
    icon: 'layout'
  },
  {
    title: 'Soporte VIP',
    desc: 'Atención personalizada para resolver cualquier duda sobre nuestra plataforma o contenidos.',
    icon: 'shield'
  }
];
---

<section class="bg-navy-light py-24 md:py-32 relative overflow-hidden">
  <!-- Grid Pattern -->
  <div class="absolute inset-0 dark-grid-pattern opacity-[0.04] pointer-events-none"></div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-20">
      <h2 class="text-tertiary text-clamp-h2 font-light mb-6">Por qué elegir <span class="italic text-secondary">Élite Educativa</span></h2>
      <div class="w-24 h-[1px] bg-secondary mx-auto"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      {features.map(f => (
        <div class="group">
          <div class="w-16 h-16 border border-secondary/30 flex items-center justify-center mb-8 group-hover:bg-secondary/10 group-hover:border-secondary transition-all duration-500">
            <div class="text-secondary">
               {f.icon === 'star' && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-star"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>}
               {f.icon === 'zap' && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>}
               {f.icon === 'layout' && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layout"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>}
               {f.icon === 'shield' && <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.5 4.8 17 6 19 6a1 1 0 0 1 1 1z"/></svg>}
            </div>
          </div>
          <h3 class="text-tertiary text-xl font-display font-medium mb-4">{f.title}</h3>
          <p class="text-tertiary/50 font-body text-sm leading-relaxed">
            {f.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
