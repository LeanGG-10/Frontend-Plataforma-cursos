---
import { Image } from 'astro:assets';
import logoLight from '../assets/logo-light-transparent.png';
import Button from './ui/Button.astro';
---

<section class="relative min-h-[92vh] w-full bg-primary flex flex-col items-center justify-center pt-24 overflow-hidden">
  <!-- Radial Glow -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(201,164,74,0.08),transparent_70%)] pointer-events-none"></div>
  
  <!-- Subtle Grid Pattern -->
  <div class="absolute inset-0 dark-grid-pattern opacity-10 pointer-events-none"></div>

  <div class="container mx-auto px-6 relative z-10 flex flex-col items-center text-center">
    <div class="mb-12 animate-fade-in">
      <Image 
        src={logoLight} 
        alt="Élite Educativa Branding" 
        width={600} 
        class="w-96 md:w-[480px] lg:w-[600px] h-auto max-w-full"
      />
    </div>

    <h1 class="text-tertiary text-clamp-h1 font-light leading-tight max-w-5xl">
      La excelencia académica <br/>
      <span class="italic text-secondary">redefinida</span> para el <span class="italic text-secondary">futuro</span>
    </h1>

    <p class="mt-8 text-tertiary/60 font-body text-lg md:text-xl max-w-2xl font-light tracking-wide">
      Accede a una colección exclusiva de conocimiento editorial diseñado para mentes ambiciosas.
    </p>

    <div class="mt-12 flex flex-col sm:flex-row gap-6">
      <Button href="#libros" variant="primary" class="px-10 py-4">
        Explorar Biblioteca
      </Button>
      <Button href="#cursos" variant="outline" class="px-10 py-4">
        Ver Cursos
      </Button>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2">
    <span class="text-secondary/40 text-[10px] tracking-[0.3em] uppercase font-bold">Scroll</span>
    <div class="w-[1px] h-12 bg-gradient-to-b from-secondary/40 to-transparent"></div>
  </div>
</section>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fadeIn 1.2s ease-out forwards;
  }
</style>
